{
  "mode": "Indexed",
  "metadata": {
    "category": "Monitoring",
    "version": "1.1.0"
  },
  "parameters": {
    "workspaceResourceId": {
      "type": "String",
      "metadata": {
        "displayName": "Log Analytics workspace",
        "description": "Select the Log Analytics workspace that will receive the DCR Error logs.",
        "strongType": "omsWorkspace",
        "assignPermissions": true
      }
    },
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "Enable or disable deployment of the diagnostic setting."
      },
      "allowedValues": [
        "DeployIfNotExists",
        "Disabled"
      ],
      "defaultValue": "DeployIfNotExists"
    }
  },
  "policyRule": {
    "if": {
      "field": "type",
      "equals": "Microsoft.Insights/dataCollectionRules"
    },
    "then": {
      "effect": "[parameters('effect')]",
      "details": {
        "type": "Microsoft.Insights/dataCollectionRules/providers/diagnosticSettings",
        "name": "Microsoft.Insights/DCR-error-log-to-log-analytics",
        "roleDefinitionIds": [
          "/providers/Microsoft.Authorization/roleDefinitions/749f88d5-cbae-40b8-bcfc-e573ddc772fa"
        ],
        "existenceCondition": {
          "allOf": [
            {
              "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
              "equals": "[parameters('workspaceResourceId')]"
            },
            {
              "field": "Microsoft.Insights/diagnosticSettings/logs.enabled",
              "equals": "true"
            }
          ]
        },
        "deployment": {
          "properties": {
            "mode": "incremental",
            "parameters": {
              "workspaceResourceId": {
                "value": "[parameters('workspaceResourceId')]"
              },
              "dcrName": {
                "value": "[field('name')]"
              }
            },
            "template": {
              "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
              "contentVersion": "1.0.0.0",
              "parameters": {
                "workspaceResourceId": {
                  "type": "string"
                },
                "dcrName": {
                  "type": "string"
                }
              },
              "resources": [
                {
                  "type": "Microsoft.Insights/dataCollectionRules/providers/diagnosticSettings",
                  "apiVersion": "2021-05-01-preview",
                  "name": "[concat(parameters('dcrName'), '/Microsoft.Insights/DCR-error-log-to-log-analytics')]",
                  "properties": {
                    "workspaceId": "[parameters('workspaceResourceId')]",
                    "logs": [
                      {
                        "category": "LogErrors",
                        "enabled": true
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
